<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ai_voice" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.voice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="المساعد الصوتي الذكي" string="المساعد الصوتي الذكي" data-key="ai_voice_assistant">
                    <h2>إعدادات المساعد الصوتي الذكي</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">رابط سيرفر الذكاء الاصطناعي</span>
                                <div class="text-muted">
                                    رابط FastAPI سيرفر معالجة الصوت الخارجي
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_voice_server_url" class="o_light_label" placeholder="http://localhost:8000/v1/process-voice"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">معرّف قاعدة البيانات (UUID)</span>
                                <div class="text-muted">
                                    المعرف المسجّل في قائمة المشتركين على السيرفر
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_voice_db_uuid" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
